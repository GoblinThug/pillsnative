{
  "name": "pillsnative",
  "productName": "Pills Native",
  "version": "3.0.1",
  "main": "main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:publish": "electron-builder --publish always",
    "mobile:prepare": "node scripts/prepare-mobile.js",
    "mobile:sync": "npm run mobile:prepare && npx cap sync android && node scripts/patch-android-manifest.js",
    "dist:android": "node scripts/build-android.js",
    "ci:version": "node scripts/ci-version.js"
  },
  "author": "Goblin_Thug",
  "license": "ISC",
  "description": "Это приложение Electron для забывчивых ребят!",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoblinThug/pillsnative.git"
  },
  "dependencies": {
    "@pillsnative/alarm-overlay": "file:plugins/alarm-overlay",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "6.2.1",
    "@capacitor/core": "6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4",
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-deb": "^7.6.1",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "^7.6.1",
    "@electron-forge/maker-squirrel": "^7.6.1",
    "@electron-forge/maker-zip": "^7.6.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.1",
    "@electron-forge/plugin-fuses": "^7.6.1",
    "@electron-forge/publisher-github": "7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^34.1.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.goblinthug.pillsnative",
    "productName": "PillsNative",
    "copyright": "Copyright © Goblin_Thug",
    "directories": {
      "output": "release",
      "buildResources": "assets/img"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "alarm-renderer.js",
      "updater.js",
      "html/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "icon": "assets/img/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/img/icon.png",
      "category": "public.app-category.medical",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "PillsNative-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "PillsNative-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/img/icon.png",
      "category": "Utility",
      "maintainer": "Goblin_Thug",
      "synopsis": "Medication reminders with alarm window and custom sounds",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PillsNative-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PillsNative",
      "installerIcon": "assets/img/icon.ico",
      "uninstallerIcon": "assets/img/icon.ico",
      "artifactName": "PillsNative-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PillsNative-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GoblinThug",
        "repo": "pillsnative",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@34.1.1": true,
    "electron-winstaller@5.4.0": true,
    "@parcel/watcher@2.5.1": true
  }
}
