{
  "appId": "com.goblinthug.pillsnative",
  "appName": "Pills Native",
  "webDir": "mobile/www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#0A84FF",
      "sound": "default"
    },
    "Preferences": {},
    "AlarmOverlay": {}
  },
  "includePlugins": [
    "@capacitor/app",
    "@capacitor/local-notifications",
    "@capacitor/preferences",
    "@pillsnative/alarm-overlay"
  ]
}
